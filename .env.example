# Local development defaults. Copy this file to .env.local and replace values.
NODE_ENV=development
PORT=3000
APOS_BASE_URL=http://localhost:3000
APOS_MONGODB_URI=mongodb://127.0.0.1:27017/wenaili

# Generate unique values. Never commit real secrets.
APOS_SECRET=replace-with-a-long-random-value
APOSTROPHE_SESSION_SECRET=replace-with-a-different-long-random-value
NEWS_API_KEY=replace-with-a-long-random-api-key

# Aliyun OSS / S3-compatible storage.
APOS_S3_BUCKET=your-bucket
APOS_S3_KEY=your-access-key
APOS_S3_SECRET=your-access-secret
APOS_S3_REGION=oss-cn-hangzhou
APOS_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
APOS_CDN_URL=

# Optional shared cache.
REDIS_URL=
